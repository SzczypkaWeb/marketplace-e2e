# Next.js (marketing/SEO)
MARKETING_URL=http://localhost:3000

# MF app: frontend-shell (host)
APP_URL=http://localhost:8080

# MF app: backend, używany przez tests/app/auth.spec.ts (login realny + GET /users)
API_URL=http://localhost:3000

# Baza backendu (Supabase, NIE lokalny Postgres) — do siewu/czyszczenia fixture
# usera (tests/app/global-setup.ts). Skopiuj wartość DATABASE_URL wprost z
# backend/.env — nie ma tu bezpiecznego domyślnego fallbacku, bo różne bazy =
# global-setup wsieje usera tam, gdzie backend go nie zobaczy.
E2E_DATABASE_URL=
E2E_TEST_EMAIL=e2e-test-user@example.com
E2E_TEST_PASSWORD=E2eTestPassword123!
