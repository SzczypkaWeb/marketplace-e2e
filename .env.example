# Next.js (marketing/SEO)
MARKETING_URL=http://localhost:3000

# MF app: frontend-shell (host)
APP_URL=http://localhost:8080

# MF app: backend, used by tests/app/auth.spec.ts (real login + GET /users)
API_URL=http://localhost:3000

# Backend's database (Supabase, NOT local Postgres) — for seeding/cleaning
# the fixture user (tests/app/auth.setup.ts). Copy the DATABASE_URL value
# straight from backend/.env — there's no safe default fallback here, because
# different databases = auth.setup seeds a user where the backend can't see it.
E2E_DATABASE_URL=
E2E_TEST_EMAIL=e2e-test-user@example.com
E2E_TEST_PASSWORD=E2eTestPassword123!
