{
  "name": "marketplace-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "A separate repo with Playwright tests for the whole marketplace.",
  "scripts": {
    "lint": "node tests/marketing/test-readme-ci-docs.js && node tests/repo-config/nvmrc.test.js",
    "test": "playwright test",
    "test:marketing": "playwright test --project=marketing",
    "test:app": "playwright test --project=app",
    "test:flows": "playwright test --project=flows",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install-browsers": "playwright install --with-deps",
    "test:docs": "node tests/marketing/test-readme-ci-orchestration.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  }
}
